# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# (선택) 이메일 발송 — Resend (https://resend.com/api-keys)
# 무료 tier: 100건/일, 3,000건/월
# 키 미설정 시 결재 알림 이메일은 자동 skip (graceful)
RESEND_API_KEY=
# 발송자 — 자체 도메인 인증 후 사용 권장 (예: 'Nexus ERP <noreply@your-domain.com>')
# 미설정 시 Resend 의 기본 onboarding 도메인 사용 (본인 이메일로만 발송 가능)
RESEND_FROM_EMAIL=

# (선택) Sentry
NEXT_PUBLIC_SENTRY_DSN=

# (선택) AI 기능 — Google Gemini 무료 tier
# https://aistudio.google.com/apikey 에서 발급 (카드 등록 불필요)
#  - 영수증 OCR (지출 등록 폼)
#  - Ask Nexus 자연어 질의 (상단바 ✨ 아이콘 / Ctrl+J)
# 키가 없으면 OCR 은 Tesseract.js 로 자동 fallback, Ask Nexus 는 비활성화 안내.
GEMINI_API_KEY=

# (선택) 국세청 사업자번호 진위확인 API
# https://www.data.go.kr/iim/api/selectAPIAcountView.do
# 키가 없으면 형식 체크섬만 검증.
NTS_API_KEY=

# (선택) 한국 공휴일 API (한국천문연구원 특일 정보)
# https://www.data.go.kr/data/15012690/openapi.do
# 키 없으면 정적 폴백 (대체공휴일 일부 미반영)
HOLIDAYS_API_KEY=

# (선택) 데모 계정 자동 로그인
# 로그인 페이지에 '데모 계정으로 둘러보기' 버튼이 활성화됨.
# Supabase Auth → Users 에서 별도 사용자 (예: demo@nexus-erp.app) 생성 후 비밀번호 입력.
# 미설정 시 데모 버튼은 노출되지만 클릭 시 안내 메시지만 표시.
DEMO_EMAIL=
DEMO_PASSWORD=

# (선택) Slack / Discord 웹훅 — 결재·이상감지 알림
# Slack: 워크스페이스 → Apps → Incoming Webhooks 에서 발급
# Discord: 채널 설정 → 통합 → 웹훅 → 새 웹훅
# 둘 다 설정하면 둘 다 발송. 미설정 시 자동 skip.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# (선택) Notion 통합 — 직원 명부 단방향 sync
# https://www.notion.so/my-integrations 에서 Internal Integration Token 발급
# Notion DB 페이지 우상단 ⋯ → Add connections 으로 통합 연결
NOTION_TOKEN=
NOTION_EMPLOYEES_DB_ID=
